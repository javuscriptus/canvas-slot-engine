# ─── окружение ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Домены, которым разрешён доступ к API (через запятую).
# Пусто = только тот же origin, откуда отдана статика.
CORS_ORIGINS=https://casino.example.com
TRUST_PROXY=1

# Домены лобби, которым разрешено встраивать игру в iframe (через запятую).
# Именно так игра поставляется оператору. Пусто = встраивание запрещено.
FRAME_ANCESTORS=https://casino.example.com

# Канал server → client для push-событий: баланс, закрытие сессии,
# режим обслуживания, промо. Ставки по нему НЕ ходят.
WS_ENABLED=1
WS_PATH=/ws
WS_HEARTBEAT_MS=25000
# Срок жизни одноразового тикета на апгрейд сокета. Токен сессии в URL
# не передаётся никогда: адрес апгрейда пишется в access-логи прокси.
WS_TICKET_TTL_MS=15000

# ─── база ────────────────────────────────────────────────────────────
DB_FILE=/var/lib/sochi-sunset/game.db

# ─── сессии ──────────────────────────────────────────────────────────
SESSION_TTL_MS=43200000
# Секрет, которым оператор подписывает launch-токены. ОБЯЗАТЕЛЕН в проде.
LAUNCH_SECRET=

# ─── кошелёк ─────────────────────────────────────────────────────────
# local    — баланс в нашей SQLite (только демо и тесты)
# seamless — баланс у оператора, ходим к нему по HTTP
WALLET_MODE=seamless
WALLET_URL=https://operator.example.com/api/wallet
WALLET_SECRET=
OPERATOR_ID=

# ─── демо ────────────────────────────────────────────────────────────
# В production обязано быть 0, иначе любой сможет открыть сессию с балансом.
DEMO_ENABLED=0
DEMO_BALANCE_MINOR=100000
DEMO_CURRENCY=RUB

# ─── лимиты ──────────────────────────────────────────────────────────
RATE_SPINS_PER_MIN=240
RATE_WS_TICKETS_PER_MIN=30

# Общие лимиты ставки в минорных единицах — применяются к валютам,
# для которых не задано отдельного правила ниже.
MIN_BET_MINOR=1
MAX_BET_MINOR=1000000

# Лимиты по валютам: КОД:МИНИМУМ:МАКСИМУМ в минорных единицах, через запятую.
# Номинал «монеты» ставки задан в server/src/money.js для каждой валюты,
# поэтому DENOMINATION_MINOR больше не нужен: в иене нет копеек, и одна
# настройка на все рынки была бы неверной по определению.
BET_LIMITS=USD:20:500000,EUR:20:500000,JPY:2000:50000000
